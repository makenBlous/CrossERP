# 默认按推荐方案使用 PostgreSQL。切换 MySQL 或 SQLite 时同时替换三条 URL。
POSTGRES_DB=crosserp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
MYSQL_DATABASE=crosserp
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

CROSSERP_OWNER_PASSWORD=change-this-owner-password
CROSSERP_APP_PASSWORD=change-this-app-password
CROSSERP_AGENT_PASSWORD=change-this-agent-password
CROSSERP_ADMIN_USERNAME=admin
CROSSERP_ADMIN_PASSWORD=change-this-admin-password

CROSSERP_DATABASE_URL=postgresql+psycopg://crosserp_app:change-this-app-password@postgres:5432/crosserp
CROSSERP_AGENT_DATABASE_URL=postgresql+psycopg://crosserp_agent:change-this-agent-password@postgres:5432/crosserp
CROSSERP_MIGRATE_DATABASE_URL=postgresql+psycopg://postgres:change-this-postgres-password@postgres:5432/crosserp
CROSSERP_COOKIE_SECURE=1
CROSSERP_PORT=8000
CROSSERP_DOMAIN=localhost
