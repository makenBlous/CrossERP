# 数据库连接串。只改这一行，即可在 SQLite / MySQL / PostgreSQL 之间切换。
# 留空时使用默认 SQLite：~/.crosserp/data.db
# SQLite：sqlite:///D:/data/crosserp.db
# MySQL：mysql+pymysql://root:dev@127.0.0.1:3306/crosserp?charset=utf8mb4
# PostgreSQL：postgresql+psycopg://postgres:dev@127.0.0.1:5432/crosserp
CROSSERP_DATABASE_URL=
CROSSERP_AUTH_MAX_FAILED_LOGINS=5
CROSSERP_AUTH_LOCKOUT_MINUTES=15
CROSSERP_AUTH_SESSION_HOURS=12
CROSSERP_AUTH_IDLE_HOURS=2
CROSSERP_AUDIT_RETENTION_BUSINESS=never
CROSSERP_AUDIT_RETENTION_SECURITY_DAYS=180
CROSSERP_COOKIE_SECURE=0
# T43 不设默认模型供应商，使用 ask 前必须填写这三个变量。
CROSSERP_MODEL_BASE_URL=
CROSSERP_MODEL=
CROSSERP_API_KEY=
